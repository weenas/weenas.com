---
// <head> tags for search engines and share cards. Pages with a version in
// each language pass `alternates` so every version lists all of them (hreflang).
import { DEFAULT_LANG, LANGS, SITE, type Lang } from "../data/site";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  ogDescription?: string;
  ogImageAlt: string;
  alternates?: boolean;
  noindex?: boolean;
  jsonLd?: object;
}

const { lang, title, description, path, ogDescription = description, ogImageAlt, alternates = false, noindex = false, jsonLd } = Astro.props;
const abs = (p: string) => new URL(p, SITE.url).href;
const canonical = abs(path);
const ogImage = abs(SITE.ogImage.path);
const others = (Object.keys(LANGS) as Lang[]).filter((l) => l !== lang);
---
<title>{title}</title>
<meta name="description" content={description}>
{noindex
  ? <meta name="robots" content="noindex">
  : <meta name="robots" content="index, follow, max-image-preview:large">}
{!noindex && <link rel="canonical" href={canonical}>}
{alternates && (Object.keys(LANGS) as Lang[]).map((l) => (
  <link rel="alternate" hreflang={LANGS[l].hreflang} href={abs(LANGS[l].path)}>
))}
{alternates && <link rel="alternate" hreflang="x-default" href={abs(LANGS[DEFAULT_LANG].path)}>}
<link rel="sitemap" href="/sitemap.xml">

<meta property="og:type" content="website">
<meta property="og:site_name" content={SITE.name}>
<meta property="og:url" content={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={ogDescription}>
<meta property="og:locale" content={LANGS[lang].ogLocale}>
{alternates && others.map((l) => <meta property="og:locale:alternate" content={LANGS[l].ogLocale}>)}
<meta property="og:image" content={ogImage}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content={String(SITE.ogImage.width)}>
<meta property="og:image:height" content={String(SITE.ogImage.height)}>
<meta property="og:image:alt" content={ogImageAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={ogDescription}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:image:alt" content={ogImageAlt}>

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
