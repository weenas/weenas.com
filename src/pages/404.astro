---
// Served (with a 404 status) for any path that has no file; see wrangler.jsonc.
import Base from "../layouts/Base.astro";
---
<Base lang="en" title="Page not found · Weenas" description="This page doesn't exist." ogImageAlt="Weenas logo" path="/404/" noindex>
  <main>
    <section class="hero not-found">
      <div class="container">
        <a href="/" aria-label="Weenas">
          <img class="hero-logo logo-light" src="/brand-assets/svg/weenas-symbol.svg" alt="Weenas" width="540" height="450">
          <img class="hero-logo logo-dark" src="/brand-assets/svg/weenas-symbol-reverse.svg" alt="Weenas" width="540" height="450">
        </a>
        <h1>404</h1>
        <p class="lead">This page doesn't exist.<br><span lang="zh-CN">页面不存在。</span></p>
        <p class="not-found-actions">
          <a class="btn btn-primary" href="/">Back to home</a>
          <a class="btn btn-ghost" href="/zh/" lang="zh-CN">返回中文首页</a>
        </p>
      </div>
    </section>
  </main>
</Base>
